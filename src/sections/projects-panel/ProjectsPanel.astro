---
// The Projects Panel: the Rail, the masthead and its two authored lines, the
// copy, the engineering points, the Frame, and the Plinth it stands on.
// NOTES.md carries the reasoning — what each share was measured from, and the
// two relationships the Cut Title is cut to.
import { content } from './content';
// The recording's poster and its own pixels. Imported rather than written out
// here so the module that fetches the clip and the element that shows it name
// one URL between them — the same arrangement the theme toggle's key has in the
// Front Screen.
import { POSTER, RECORDING } from './clip';
import './tokens.css';
// variants.css is deliberately NOT imported. NOTES.md, and check-source.mjs if
// this is ever undone.

/** The fragment the Rail's own entry names, and the Section's deep link. */
const here = 'projects';
const selected = (project: { href?: string }) => project.href === `#${here}`;
---

{/* data-section is the loader's handle. No data-turn: the crossing into dark
    happens across the scroll of the Section ABOVE this one, which is where the
    reader is when it happens — see NOTES.md. */}
<section
  class="projects-panel"
  id={here}
  data-section="projects-panel"
  aria-labelledby="projects-panel-masthead"
>
  <nav class="projects-panel__rail" aria-label={content.rail.label}>
    {/* role="list" on a list that already is one: `list-style: none` costs a
        list its semantics in VoiceOver, and the Rail is meant to be announced
        as a list of projects. */}
    <ul class="projects-panel__rail-items" role="list">
      {content.rail.projects.map((project) => (
        <li class:list={['projects-panel__rail-item', { 'is-selected': selected(project) }]}>
          {project.href ? (
            <a href={project.href} aria-current={selected(project) ? 'true' : undefined}>
              {project.name}
            </a>
          ) : (
            <Fragment>
              {project.name}
              <span class="projects-panel__quiet">{content.rail.unbuilt}</span>
            </Fragment>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <div class="projects-panel__inner">
    <header class="projects-panel__head">
      <h2 class="projects-panel__masthead" id="projects-panel-masthead">{content.masthead}</h2>
      <p class="projects-panel__sub">
        {content.subheading.map((line) => (
          <span>{line}</span>
        ))}
      </p>
    </header>
    <div class="projects-panel__copy">
      {content.copy.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <ol class="projects-panel__points">
      {content.points.map((point) => (
        <li>
          <h3>{point.title}</h3>
          <p>{point.figure}</p>
        </li>
      ))}
    </ol>
    {/* The stage: the Frame, and the Plinth it stands on — one grid item holding
        two, because the two do not have the same left edge and because the slab
        has to hang off the Frame's FOOT, which is a length the grid knows and no
        sibling of the Frame could ask for. Decorative, so the whole box is out of
        the accessibility tree, and the attribute is on the stage rather than on
        each half so the reflection inherits it: a screen reader offered the
        window twice would be worse than being offered it once. NOTES.md. */}
    <div class="projects-panel__stage" aria-hidden="true">
      <div class="projects-panel__frame">
        {/* The titlebar. Its material is not markup: two of the three rungs are
            this element's own background and the third is the canvas below.
            `data-glass` says which engaged. NOTES.md. */}
        <div class="projects-panel__bar">
          {/* First, so the chrome is drawn over it: the controls sit ON the
              glass. In the markup rather than created in script because a scoped
              rule cannot reach an element the compiler never saw. NOTES.md. */}
          <canvas class="projects-panel__glass"></canvas>
          {/* NOT ONE OF THESE IS A CONTROL — every one is a span or an i, with
              no tabindex and no handler, and the Check asserts it stays that way.
              Each viewBox is the glyph's measured ink in the render's own pixels,
              which is what lets the stylesheet set a width and leave the height
              alone. NOTES.md. */}
          <div class="projects-panel__chrome">
            <span class="projects-panel__lights"><i></i><i></i><i></i></span>
            {/* A window with its left pane filled. */}
            <span class="projects-panel__icon projects-panel__sidebar">
              <svg viewBox="0 0 26 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="0.75" y="0.75" width="24.5" height="14.5" rx="2.5"></rect>
                <path d="M9.5 0.75V15.25"></path>
                <rect x="3.4" y="3.6" width="3.2" height="8.8" rx="1" fill="currentColor" stroke="none"></rect>
              </svg>
            </span>
            {/* Back, and forward greyed out beside it: a browser saying there
                is nowhere forward to go. */}
            <span class="projects-panel__icon projects-panel__back">
              <svg
                viewBox="0 0 10 18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M8.5 1.5 1.5 9l7 7.5"></path>
              </svg>
            </span>
            <span class="projects-panel__icon projects-panel__fwd">
              <svg
                viewBox="0 0 10 18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1.5 1.5 8.5 9l-7 7.5"></path>
              </svg>
            </span>
            {/* The address is the truth and not a decoration, which is why it
                is Content. NOTES.md. */}
            <span class="projects-panel__address">
              <span class="projects-panel__address-text">{content.frame.address}</span>
              <span class="projects-panel__icon projects-panel__reload">
                <svg
                  viewBox="0 0 16 18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M13.5 9a5.5 5.5 0 1 1-1.9-4.2"></path>
                  <path d="M13.9 1.4v3.6h-3.6"></path>
                </svg>
              </span>
            </span>
            {/* Share, new tab, tabs. */}
            <span class="projects-panel__icon projects-panel__share">
              <svg
                viewBox="0 0 22 21"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 8.2H2.75v11.05h16.5V8.2H16"></path>
                <path d="M11 1v11.4M11 1 7.3 4.8M11 1l3.7 3.8"></path>
              </svg>
            </span>
            <span class="projects-panel__icon projects-panel__new">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M10 1.5v17M1.5 10h17"></path>
              </svg>
            </span>
            {/* Two tabs. The back one's path is the part of an identical
                rounded rect the front one does not cover, so it begins and ends
                ON the front tab's outline — a bare corner reads as a hook. */}
            <span class="projects-panel__icon projects-panel__tabs">
              <svg viewBox="0 0 25 17" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="0.75" y="0.75" width="17" height="11.5" rx="2.5"></rect>
                <path
                  d="M17.75 4.75h3.5a2.5 2.5 0 0 1 2.5 2.5v6.5a2.5 2.5 0 0 1-2.5 2.5H9.25a2.5 2.5 0 0 1-2.5-2.5v-1.5"
                ></path>
              </svg>
            </span>
          </div>
        </div>
        {/* The window's content: inset from the window's edge on three sides.
            The crop happens here rather than on the Frame, because this box is
            the shape the recording has to fill and it is not the Frame's. */}
        <div class="projects-panel__content">
          {/* NO `src` AND NO `<source>`, WHICH IS THE POINT. The sources are
              given by clip.ts and only when the reader has not asked for reduced
              motion, so under that setting the poster is the whole of it and the
              files are never requested. `preload="none"` would not have done it
              and neither would a CSS rule; clip.ts says why at length.
              `muted` is not decoration either: it is what lets `autoplay` run at
              all, and the Portfolio never makes a sound. */}
          <video
            class="projects-panel__clip"
            poster={POSTER}
            width={RECORDING.width}
            height={RECORDING.height}
            autoplay
            loop
            muted
            playsinline
            preload="none"></video>
        </div>
      </div>
      {/* The marble the Frame stands on, and the live reflection of the Frame
          lying in it.

          EMPTY, AND BOTH HALVES OF IT ARE. The slab is one rendered plate — the
          Plinth block below names it and design/plinth/build-slab.py is what
          renders it — and the reflection is a copy of the Frame that reflection.ts
          clones into the box, chrome, titlebar, recording and all. There is no
          second copy of the window written out here, deliberately: two
          hand-kept copies of a hundred lines of measured drawing is a drift
          waiting to happen, and reflection.ts says why script is the right place.

          A BROWSER THAT NEVER RUNS THAT SCRIPT GETS THE MARBLE AND NO
          REFLECTION, which is deliberate rather than broken — the stance every
          other script in this Section takes. Polished stone with nothing in it
          is a plinth; it is only the window's own reflection that is missing,
          and there is nothing on the page to say it was ever promised. */}
      <div class="projects-panel__plinth">
        <div class="projects-panel__reflection"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scoped by the build: none of these selectors can match an element in another
     Section. Every length is a share of one width — NOTES.md is the derivation. */

  .projects-panel {
    /* ---- the one length everything else is a share of --------------------- */
    --projects-panel-fit-w: calc(
      (var(--fold) - 2 * var(--projects-panel-inset)) / var(--projects-panel-fit)
    );
    --projects-panel-w: min(
      calc(var(--projects-panel-across) * (100vw - 2 * var(--projects-panel-inset))),
      var(--projects-panel-fit-w)
    );

    /* ---- the type scale, resolved ----------------------------------------- */
    --projects-panel-masthead-size: calc(
      var(--projects-panel-masthead-share) * var(--projects-panel-w)
    );
    --projects-panel-sub-size: calc(var(--projects-panel-sub-share) * var(--projects-panel-w));
    --projects-panel-copy-size: calc(var(--projects-panel-copy-share) * var(--projects-panel-w));
    --projects-panel-small-size: max(
      var(--projects-panel-small-floor),
      calc(var(--projects-panel-small-share) * var(--projects-panel-w))
    );
    --projects-panel-rail-size: max(
      var(--projects-panel-rail-floor),
      calc(var(--projects-panel-rail-share) * var(--projects-panel-w))
    );

    /* ---- the gutters, resolved -------------------------------------------- */
    --projects-panel-gap: calc(var(--projects-panel-gap-share) * var(--projects-panel-w));
    --projects-panel-gutter: calc(var(--projects-panel-gutter-share) * var(--projects-panel-w));
    --projects-panel-copy-inset: calc(
      var(--projects-panel-copy-inset-share) * var(--projects-panel-w)
    );
    --projects-panel-points-gap: calc(
      var(--projects-panel-points-gap-share) * var(--projects-panel-w)
    );
    --projects-panel-points-air: calc(
      var(--projects-panel-points-air-share) * var(--projects-panel-w)
    );
    --projects-panel-rail-w: calc(
      var(--projects-panel-leading) * var(--projects-panel-rail-size)
    );

    /* ---- the two lengths the composition's height is built out of --------- */
    --projects-panel-mast-line: calc(
      var(--projects-panel-masthead-leading) * var(--projects-panel-masthead-size)
    );
    --projects-panel-sub-line: calc(
      var(--projects-panel-sub-leading) * var(--projects-panel-sub-size)
    );

    /* ---- the Frame -------------------------------------------------------
       One column of the twelve, once the eleven gutters are taken out. The Frame
       is nine of them and the stage ten, both by placement, so the only length
       written here is the overhang between the two. NOTES.md. */
    --projects-panel-column: calc((1 - 11 * var(--projects-panel-gutter-share)) / 12);
    --projects-panel-frame-drop: calc(
      var(--projects-panel-frame-drop-share) * var(--projects-panel-sub-line)
    );

    /* ---- and the two shares the Plinth is stated against ------------------
       The Frame's nine columns and the eight gutters inside them, and the
       stage's ten and nine. Both by PLACEMENT — nothing lays out from either,
       the Frame's width is `auto` and the stage's is the grid's — so these exist
       for the two things that have to know a width they cannot measure.
       Neither is a Token: both are the grid, restated. */
    --projects-panel-frame-share: calc(
      9 * var(--projects-panel-column) + 8 * var(--projects-panel-gutter-share)
    );
    --projects-panel-stage-share: calc(
      10 * var(--projects-panel-column) + 9 * var(--projects-panel-gutter-share)
    );
    /* The Frame's width as a plain length, which is what the Plinth's three
       depths are shares OF. It OVER-STATES the laid-out Frame by whatever the
       Rail's floor costs the composition — 3px at 1440x900 — because
       --projects-panel-w is what the fit asked for and the grid caps it at what
       is actually free. That is why the window's corner is a percentage of its
       own box instead of reading this, and why the Plinth's horizontal geometry
       below is a percentage of the stage: the only things that read this are the
       three DEPTHS, where 3px of width is 0.05px of face. NOTES.md. */
    --projects-panel-frame-w: calc(var(--projects-panel-frame-share) * var(--projects-panel-w));

    /* ---- the Plinth's three depths, resolved ------------------------------
       So no rule below multiplies by the Frame's width on its own. `depth` is
       what the slab costs the composition and `back` is what it does not: the
       two together are the box the plate is drawn in, and `depth` alone is the
       flow height — which is the same 0.0869 of a Frame width the fit constant
       has counted since before any of this was on the page. */
    --projects-panel-plinth-face: calc(
      var(--projects-panel-plinth-top) * var(--projects-panel-frame-w)
    );
    --projects-panel-plinth-back: calc(
      var(--projects-panel-plinth-behind) * var(--projects-panel-frame-w)
    );
    --projects-panel-plinth-depth: calc(
      (var(--projects-panel-plinth-top) + var(--projects-panel-plinth-front)) *
        var(--projects-panel-frame-w)
    );
    /* And the Frame's own two edges as a share of the SLAB, which is what the
       two boxes lying on the top face are placed by. Symmetric, so it is one
       number rather than two — the shortest way to say that the window sits in
       the middle of the stone it stands on — and derived here rather than
       written out at each of the four sites that read it. */
    --projects-panel-plinth-inset: calc(
      var(--projects-panel-plinth-overhang) /
        (1 + 2 * var(--projects-panel-plinth-overhang)) * 100%
    );

    /* ---- and the two the Cut Title is cut to ------------------------------ */
    /* Face metrics rather than choices, which is why they are not Tokens. */
    --projects-panel-masthead-cap: calc(0.7 * var(--projects-panel-masthead-size));
    --projects-panel-mast-top: calc(0.08 * var(--projects-panel-masthead-size));

    /* ---- the palette, as the far end of a crossing rather than a constant -- */
    --projects-panel-bg: color-mix(
      in oklab,
      var(--projects-panel-bg-far) calc(var(--turn) * 100%),
      var(--ground)
    );
    --projects-panel-ink: color-mix(
      in oklab,
      var(--projects-panel-ink-far) calc(var(--turn) * 100%),
      var(--ink)
    );
    --projects-panel-ink-soft: color-mix(
      in oklab,
      var(--projects-panel-ink-soft-far) calc(var(--turn) * 100%),
      var(--ink-soft)
    );
    --projects-panel-muted: color-mix(
      in oklab,
      var(--projects-panel-muted-far) calc(var(--turn) * 100%),
      var(--ink-soft)
    );
    --projects-panel-rule: color-mix(
      in oklab,
      var(--projects-panel-rule-far) calc(var(--turn) * 100%),
      var(--projects-panel-rule-near)
    );
    /* The Frame's body and rim cross too, from the page's own paper. The
       chrome's ink does not — NOTES.md says whose decision that is. */
    --projects-panel-frame-fill: color-mix(
      in oklab,
      var(--projects-panel-frame-fill-far) calc(var(--turn) * 100%),
      var(--ground)
    );
    --projects-panel-frame-edge: color-mix(
      in oklab,
      var(--projects-panel-frame-edge-far) calc(var(--turn) * 100%),
      var(--projects-panel-rule-near)
    );

    box-sizing: border-box;
    position: relative;
    display: grid;
    grid-template-columns: var(--projects-panel-rail-w) minmax(0, var(--projects-panel-w));
    justify-content: center;
    align-items: center;
    column-gap: var(--projects-panel-gap);
    min-height: var(--fold);
    padding: var(--projects-panel-inset);
    /* Clip, not hidden, and only across: `hidden` would make the Section a
       scroll container and break the Rail. */
    overflow-x: clip;
    background: var(--projects-panel-bg);
    color: var(--projects-panel-ink);
    font-family: var(--face-panel);
    font-weight: 400;
    line-height: var(--projects-panel-leading);
    /* The landing, and the whole of the Cut Title relationship in use: the deep
       link comes to rest on the masthead's cap top rather than on the Section's
       own edge. */
    scroll-margin-top: calc(var(--projects-panel-inset) - var(--projects-panel-mast-top));
  }

  /* ---- the Rail --------------------------------------------------------- */
  .projects-panel__rail {
    /* The one thing in the Section that answers to the SCREEN and not to the
       composition. */
    display: flex;
    align-self: stretch;
  }

  .projects-panel__rail-items {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  .projects-panel__rail-item {
    /* Turned per ITEM and not on the list: rotating the list would rotate the
       order with it. */
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-size: var(--projects-panel-rail-size);
    letter-spacing: var(--projects-panel-rail-tracking);
    color: var(--projects-panel-muted);
  }

  .projects-panel__rail-item.is-selected {
    color: var(--projects-panel-ink);
  }

  .projects-panel__rail-item a {
    color: inherit;
    /* Three words in a margin: an underline across a rotated one reads as a
       strikethrough. */
    text-decoration: none;
  }

  .projects-panel__rail-item:not(.is-selected) a:hover {
    color: var(--projects-panel-ink);
  }

  .projects-panel__rail-item a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 3px;
  }

  .projects-panel__quiet {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }

  /* ---- the composition: twelve columns, two rows ------------------------- */
  .projects-panel__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: calc(var(--projects-panel-mast-line) + var(--projects-panel-sub-line)) 1fr;
    column-gap: var(--projects-panel-gutter);
    /* No row gap. The seam between the two rows IS the subheading's second
       line's top edge — see NOTES.md. */
    row-gap: 0;
    align-self: center;
  }

  .projects-panel__head {
    grid-area: 1 / 1 / 2 / 7;
    align-self: end;
    /* Exactly one subheading line, so the head's box ends after the FIRST line
       and the second hangs into row two. */
    margin-bottom: calc(-1 * var(--projects-panel-sub-line));
  }

  /* ---- how the five capitalised things are set --------------------------- */
  /* Listed rather than hoisted onto the Section: `case` on the body copy would
     raise the hyphen in "content-addressed" off its own baseline. */
  .projects-panel__masthead,
  .projects-panel__sub,
  .projects-panel__rail-item,
  .projects-panel__points h3,
  .projects-panel__points p {
    text-transform: uppercase;
    font-feature-settings: 'case' 1;
  }

  .projects-panel__masthead {
    margin: 0;
    font-size: var(--projects-panel-masthead-size);
    font-weight: var(--projects-panel-masthead-weight);
    line-height: var(--projects-panel-masthead-leading);
    letter-spacing: var(--projects-panel-masthead-tracking);
    color: var(--projects-panel-ink);
  }

  .projects-panel__sub {
    margin: 0;
    font-size: var(--projects-panel-sub-size);
    font-weight: 400;
    line-height: var(--projects-panel-sub-leading);
    color: var(--projects-panel-muted);
  }

  /* `block` on the spans rather than a <br>, so the break is a property of the
     composition and not a character a screen reader has to read around. */
  .projects-panel__sub span {
    display: block;
  }

  .projects-panel__copy {
    grid-area: 1 / 7 / 2 / 13;
    align-self: start;
    border-left: 1px solid var(--projects-panel-rule);
    padding-left: var(--projects-panel-copy-inset);
    font-size: var(--projects-panel-copy-size);
    line-height: var(--projects-panel-copy-leading);
    color: var(--projects-panel-ink-soft);
  }

  .projects-panel__copy p {
    margin: 0;
  }

  .projects-panel__copy p + p {
    margin-top: 1em;
  }

  /* An <ol> because the order IS the ranking; the numbers are off because the
     figures are the numbers this column is about. */
  .projects-panel__points {
    grid-area: 2 / 1 / 3 / 4;
    align-self: start;
    /* One hanging subheading line, plus air. A longhand would be shorter and
       would also reset the list-style and the padding below it. */
    margin: calc(var(--projects-panel-sub-line) + var(--projects-panel-points-air)) 0 0;
    list-style: none;
    padding: 0;
    display: grid;
    row-gap: var(--projects-panel-points-gap);
  }

  .projects-panel__points h3 {
    margin: 0;
    font-size: var(--projects-panel-small-size);
    font-weight: var(--projects-panel-point-weight);
    line-height: var(--projects-panel-point-leading);
    letter-spacing: var(--projects-panel-point-tracking);
    color: var(--projects-panel-ink);
  }

  .projects-panel__points p {
    margin: var(--projects-panel-figure-air) 0 0;
    font-size: var(--projects-panel-small-size);
    line-height: var(--projects-panel-figure-leading);
    letter-spacing: var(--projects-panel-figure-tracking);
    color: var(--projects-panel-muted);
  }


  /* ---- the stage: the Frame, and the Plinth #140 stands it on ------------
     Ten columns of twelve against the Frame's nine. The Frame's left edge lands
     UNDER the subheading's second line, which is the horizontal half of the
     occlusion; the drop below is the vertical one. NOTES.md. */
  .projects-panel__stage {
    grid-area: 2 / 3 / 3 / 13;
    align-self: start;
    margin-top: var(--projects-panel-frame-drop);
    /* No z-index, and none of the other four: a stacking context here stops the
       Frame painting over the type it occludes. The Check asserts all five. */
    position: relative;
  }

  /* One column and one gutter in — the column the Plinth overhangs by. Width is
     left to `auto`, which is exactly the rest of the box. Scoped to the stage's
     own child so the reflection's clone is not indented by it.

     A PERCENTAGE OF THE STAGE and not that share times the composition's width,
     which is what it was and is 0.36px to the right of this at 1440x900. The two
     differ because --projects-panel-w is what the FIT asked for and the grid
     caps the column at what is actually free, so a length derived from it
     over-states the laid-out box by whatever the Rail's floor cost — see
     --projects-panel-frame-w. It did not matter while the Frame was the only
     thing in the stage. It matters now: the Plinth is stated as a percentage of
     the same box, so the two would disagree about where the window's edge is by
     that 0.36px, and the reflection — which is placed off the SLAB — would lie
     half a pixel off the window it reflects at every width. Both read the same
     box now and the arithmetic is exact. */
  .projects-panel__stage > .projects-panel__frame {
    margin-left: calc(
      (var(--projects-panel-column) + var(--projects-panel-gutter-share)) /
        var(--projects-panel-stage-share) * 100%
    );
  }

  .projects-panel__frame {
    z-index: 1;
    position: relative;
    aspect-ratio: var(--projects-panel-frame-ratio);
    background: var(--projects-panel-frame-fill);
    /* A PERCENTAGE and never a cqw: an element is not its own container, so a
       cqw here resolves against the viewport. The second half is the same length
       against the height, or the corner is an ellipse. NOTES.md. */
    border-radius: calc(var(--projects-panel-frame-corner) * 100%) /
      calc(var(--projects-panel-frame-corner) * var(--projects-panel-frame-ratio) * 100%);
    /* A ring and not a `border`: a border would put the window's edge inside
       the titlebar. NOTES.md. */
    box-shadow: inset 0 0 0 1px var(--projects-panel-frame-edge);
    /* Every length in the chrome is a share of this box's width. `inline-size`
       and not `size`: the height comes from aspect-ratio. NOTES.md. */
    container-type: inline-size;

    /* In cqw, so resolved wherever they are USED — which is why each is used on
       a descendant of this box and never on this box itself. */
    --projects-panel-frame-bar-h: calc(var(--projects-panel-frame-bar) * 100cqw);
    --projects-panel-frame-radius: calc(var(--projects-panel-frame-corner) * 100cqw);
    --projects-panel-frame-band: calc(var(--projects-panel-frame-inset) * 100cqw);
  }

  /* ---- the titlebar, and the three materials it can be made of -----------
     THE LADDER IS THE CASCADE, not a chain of ifs: this rule is the flat rung and
     what a browser that never runs glass.ts gets, the @supports block below is
     the blurred one, and the canvas turns both off when the shader has drawn.
     The fill is not a chosen colour — it is #66's tint times the 0.8 the shader
     multiplies its alpha by, which is why the 0.8 is written here rather than
     folded into the Token. NOTES.md. */
  .projects-panel__bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--projects-panel-frame-bar-h);
    /* Above the recording: the glass is a lens, and a lens is in front of what
       it bends. Source order cannot do it — the canvas is a child of this. */
    z-index: 1;
    /* The window's own top corners, and the only two the Frame has. */
    border-radius: var(--projects-panel-frame-radius) var(--projects-panel-frame-radius) 0 0;
    background: color-mix(
      in srgb,
      var(--projects-panel-frame-tint) calc(var(--projects-panel-frame-tint-alpha) * 80%),
      transparent
    );
    /* No rim of its own: the Frame's ring shows through the translucent fill,
       and a second ring puts two on the same pixel. NOTES.md. */
  }

  /* The blurred rung. The blur does nothing today — what is behind the titlebar
     is the Frame's own flat fill — and is written now so that #140 moves a
     backdrop and not a ladder. THE TWO RIMS COMPOSITE, which is why the second's
     alpha is solved out of the pair rather than set to the measured total: at the
     total the two ends come out half again too bright. NOTES.md. */
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .projects-panel__bar {
      --projects-panel-frame-glare: calc(
        (var(--projects-panel-frame-rim-ends) - var(--projects-panel-frame-rim)) /
          (1 - var(--projects-panel-frame-rim))
      );

      -webkit-backdrop-filter: blur(calc(var(--projects-panel-frame-blur) * 100cqw));
      backdrop-filter: blur(calc(var(--projects-panel-frame-blur) * 100cqw));
      box-shadow:
        inset 0 0 0 1px rgb(255 255 255 / calc(var(--projects-panel-frame-rim) * 100%)),
        inset 1px 0 0 0 rgb(255 255 255 / calc(var(--projects-panel-frame-glare) * 100%)),
        inset -1px 0 0 0 rgb(255 255 255 / calc(var(--projects-panel-frame-glare) * 100%));
    }
  }

  /* The shader rung. The two below are turned OFF rather than painted over: a
     backdrop-filter under an opaque child still costs a pass per composite. */
  .projects-panel__bar[data-glass='webgl'] {
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
  }

  /* Sized in CSS, so a resize is a repaint of a canvas that is already the
     right shape. Hidden until the shader has drawn, off the same attribute that
     turns the two rungs below off — the context is opaque, so a canvas shown
     early is a blank strip and one left showing after a lost context is a
     titlebar the Frame no longer has. The clip gives up half a pixel of
     superellipse. NOTES.md. */
  .projects-panel__glass {
    display: none;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    /* Inert like everything else in the window. */
    pointer-events: none;
  }

  .projects-panel__bar[data-glass='webgl'] .projects-panel__glass {
    display: block;
  }

  /* ---- the controls ------------------------------------------------------
     A FLEX ROW, NOT TEN ABSOLUTE PERCENTAGES, and EVERY GAP BELOW IS COMPUTED
     FROM THE PAIR EITHER SIDE OF IT: two measured centres, less the two
     half-widths between them. Flattening one back into the length it comes to is
     what this whole block exists not to be — the Check fails on it. The field is
     the exception, and is centred on the Frame. NOTES.md. */
  .projects-panel__chrome {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    /* In to the first light's centre, less half the disc that stands on it. */
    padding-left: calc(
      (var(--projects-panel-frame-light-centre) - var(--projects-panel-frame-light-w) / 2) * 100cqw
    );
    /* And in from the right: what is left past the tabs glyph's outer edge. */
    padding-right: calc(
      (1 - var(--projects-panel-frame-tabs-centre) - var(--projects-panel-frame-tabs-w) / 2) * 100cqw
    );
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .projects-panel__lights {
    display: flex;
    /* The pitch between two centres, less the disc that stands on each. */
    gap: calc(
      (var(--projects-panel-frame-light-pitch) - var(--projects-panel-frame-light-w)) * 100cqw
    );
  }

  .projects-panel__lights i {
    width: calc(var(--projects-panel-frame-light-w) * 100cqw);
    height: calc(var(--projects-panel-frame-light-w) * 100cqw);
    border-radius: 50%;
    background: var(--projects-panel-frame-light);
  }

  /* The viewBox is scaled so the stroke lands on the box's edges, which is why
     the share in the rule is the share in the render's table. */
  .projects-panel__icon {
    display: block;
    flex: 0 0 auto;
    color: var(--projects-panel-frame-ink);
  }

  .projects-panel__icon svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Two pitches past the first light's centre: the one gap in the row whose
     left-hand neighbour is not the element before it. */
  .projects-panel__sidebar {
    width: calc(var(--projects-panel-frame-sidebar-w) * 100cqw);
    margin-left: calc(
      (
          var(--projects-panel-frame-sidebar-centre) - var(--projects-panel-frame-sidebar-w) / 2 -
            var(--projects-panel-frame-light-centre) - 2 * var(--projects-panel-frame-light-pitch) -
            var(--projects-panel-frame-light-w) / 2
        ) * 100cqw
    );
  }

  .projects-panel__back {
    width: calc(var(--projects-panel-frame-chevron-w) * 100cqw);
    margin-left: calc(
      (
          var(--projects-panel-frame-back-centre) - var(--projects-panel-frame-chevron-w) / 2 -
            var(--projects-panel-frame-sidebar-centre) - var(--projects-panel-frame-sidebar-w) / 2
        ) * 100cqw
    );
  }

  /* One width for both chevrons, so this gap is centre to centre less it. */
  .projects-panel__fwd {
    width: calc(var(--projects-panel-frame-chevron-w) * 100cqw);
    margin-left: calc(
      (
          var(--projects-panel-frame-fwd-centre) - var(--projects-panel-frame-back-centre) -
            var(--projects-panel-frame-chevron-w)
        ) * 100cqw
    );
    color: var(--projects-panel-frame-ink-off);
  }

  /* Absolutely placed, because it is centred on the FRAME and the row's two
     clusters are not the same width. Drawn on the middle rather than at its
     measured centre a fifth of a per cent past it — NOTES.md, which is also where
     the measured centre goes on being used. */
  .projects-panel__address {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: calc(var(--projects-panel-frame-address-w) * 100cqw);
    height: calc(var(--projects-panel-frame-address-h) * 100cqw);
    border-radius: calc(var(--projects-panel-frame-address-corner) * 100cqw);
    background: var(--projects-panel-frame-address-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .projects-panel__address-text {
    font-size: calc(var(--projects-panel-frame-address-size) * 100cqw);
    line-height: 1;
    letter-spacing: var(--projects-panel-frame-address-tracking);
    color: var(--projects-panel-frame-address-ink);
    /* Tabular, so the address's four groups cannot shift under each other. */
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Against the field's right edge and not at its own centre, because it belongs
     to the field and travels with it: one measured edge against another. */
  .projects-panel__reload {
    position: absolute;
    right: calc(
      (
          var(--projects-panel-frame-address-centre) + var(--projects-panel-frame-address-w) / 2 -
            var(--projects-panel-frame-reload-centre) - var(--projects-panel-frame-reload-w) / 2
        ) * 100cqw
    );
    width: calc(var(--projects-panel-frame-reload-w) * 100cqw);
  }

  /* `auto` pushes the cluster to the padding edge, which is exactly where the
     three measured centres put it — the padding is measured off the last. */
  .projects-panel__share {
    width: calc(var(--projects-panel-frame-share-w) * 100cqw);
    margin-left: auto;
  }

  .projects-panel__new {
    width: calc(var(--projects-panel-frame-new-w) * 100cqw);
    margin-left: calc(
      (
          var(--projects-panel-frame-new-centre) - var(--projects-panel-frame-new-w) / 2 -
            var(--projects-panel-frame-share-centre) - var(--projects-panel-frame-share-w) / 2
        ) * 100cqw
    );
  }

  .projects-panel__tabs {
    width: calc(var(--projects-panel-frame-tabs-w) * 100cqw);
    margin-left: calc(
      (
          var(--projects-panel-frame-tabs-centre) - var(--projects-panel-frame-tabs-w) / 2 -
            var(--projects-panel-frame-new-centre) - var(--projects-panel-frame-new-w) / 2
        ) * 100cqw
    );
  }

  /* ---- what is left of the chrome on a small Frame ----------------------
     Below 520px of Frame the small glyphs are dropped rather than drawn as grey
     noise in the shape of a titlebar. A CONTAINER QUERY AND NOT A MEDIA QUERY:
     the question is how wide the FRAME is, and a short wide window draws a small
     Frame, so a viewport gate would be asking about the wrong box. The Check
     measures at 1440x450 for exactly that. NOTES.md. */
  @container (max-width: 520px) {
    .projects-panel__sidebar,
    .projects-panel__back,
    .projects-panel__fwd,
    .projects-panel__share,
    .projects-panel__new,
    .projects-panel__tabs,
    .projects-panel__reload,
    .projects-panel__address-text {
      display: none;
    }
  }

  /* ---- the window's content ----------------------------------------------
     Inset on three sides and flush at the TOP, so this box is not concentric with
     the window. Empty until #140. NOTES.md. */
  .projects-panel__content {
    position: absolute;
    top: var(--projects-panel-frame-bar-h);
    left: var(--projects-panel-frame-band);
    right: var(--projects-panel-frame-band);
    bottom: var(--projects-panel-frame-band);
    /* The window's corner less the band it is inset by — written as the
       subtraction, not as the band it happens to come within a thousandth of. */
    border-radius: calc(
      (var(--projects-panel-frame-corner) - var(--projects-panel-frame-inset)) * 100cqw
    );
    /* The crop below has to happen somewhere, and the corners with it. */
    overflow: hidden;
  }

  /* ---- the recording -------------------------------------------------------
     THE CLIP AND THE CONTENT BOX ARE NOT THE SAME SHAPE, and this is where that
     is settled rather than hidden. The recording is 1440x900 — `record`'s
     viewport, and the geometry the censored list was assembled at, so it is not
     free to move: change it and the clip passes over photographs nobody
     reviewed. They cannot be reconciled by choosing better numbers either: the
     render's Frame is 1430 wide by 735 including its titlebar, and 1430 of a 1.6
     recording is 894 tall before a titlebar is added at all. Something is
     cropped, and it is the recording rather than the window the whole design is
     drawn around.

     `cover` FROM THE TOP EDGE, so all of the cut comes off the bottom. That
     keeps the vault's own toolbar hard against the top of the box — the row that
     says this is an application and not a wall of pictures, and where a real
     window's content starts. It is also the only direction that is SAFE:
     cropping the bottom of the viewport can only ever remove what the clip
     shows, and what the clip shows is what the censored list was signed against.

     NO `background` OF ITS OWN. The Frame's fill is behind it, and it is what
     shows between the poster arriving and the first decoded frame — and all that
     shows in a browser that plays neither. */
  .projects-panel__clip {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  /* ---- the Plinth ----------------------------------------------------------
     THE MARBLE THE FRAME STANDS ON. One rendered plate, drawn in a box whose
     aspect ratio design/plinth/build-slab.py frames its camera on — which is why
     `background-size` is `100% 100%` and not `cover`: stretching the plate to
     this box is an identity, and `cover` would crop off either the far edge or
     the block's base. It is the one declaration in here that would be a bug if
     it were the usual thing.

     IN FLOW, DIRECTLY UNDER THE FRAME, and not absolutely placed at `top: 100%`
     — which draws the same picture and is wrong. The slab is part of the
     composition's height: the fit constant that scales the whole drawing onto
     one screen counts it, and an out-of-flow slab would leave the stage exactly
     as tall as the Frame while the constant said otherwise, so the composition
     would come out short by the Plinth's depth at every window size. In flow,
     the stage measures what the arithmetic assumes.

     IT ALSO STARTS ABOVE THE FRAME'S FOOT. The Frame stands ON the top face
     rather than at the back of it, so the box runs `back` higher than the
     contact line and is pulled up by exactly that. The negative margin is what
     keeps the arithmetic honest: the box is `depth + back` tall and costs the
     flow only `depth`. Nothing above this rule moves.

     AND ITS RIGHT END IS THE PAGE'S RIGHT EDGE. The Frame is flush with the
     composition's right edge, so a slab that overhangs it symmetrically needs
     room on that side that the composition does not have. Nothing here is what
     found it: THE PAGE'S WIDTH IS SPENT ON THE DRAWING AND THE STONE TOGETHER,
     one line in src/kernel/landing.css, which makes the composition a little
     under a per cent narrower and lands the marble's right end exactly on the
     window's edge. Read that comment before changing anything on this side of it.

     THE WINDOW IS STILL NOT MOVED LEFT TO MAKE ROOM. That was tried, and it puts
     the Frame over the engineering points, 42px of live text behind it at
     1600x1000; a nudge on the stage alone would do the same thing more quietly,
     eating into the gutter between the list and the window at every width and
     crossing it above about 1550. The Frame is allowed to occlude the subheading,
     which is set to be occluded; it is not allowed to eat the list. Narrowing the
     whole drawing is the move that costs the gutter nothing, because the gutter
     narrows with it.

     `overflow-x: clip` on the Section stays, and still matters: outside the
     landing band nothing solves for the stone, and a classic scrollbar makes
     `100vw` about 15px wider than the box the drawing was laid out in — so the
     far end can still land a few pixels past the edge, which is what the render
     itself does with its own slab. */
  .projects-panel__plinth {
    position: relative;
    /* Under the Frame, which carries `z-index: 1`. The marble behind the contact
       line is drawn and then covered by the window standing on it, which is what
       leaves it visible only at the two ends, where there is no window. */
    z-index: 0;
    /* Both a percentage of the STAGE, and both derived rather than written: the
       Frame's own left edge, less one overhang, and the Frame plus two. The
       Frame's margin above reads the same box, so the slab is symmetric about
       the window by construction. */
    margin-left: calc(
      (
          var(--projects-panel-column) + var(--projects-panel-gutter-share) -
            var(--projects-panel-plinth-overhang) * var(--projects-panel-frame-share)
        ) / var(--projects-panel-stage-share) * 100%
    );
    width: calc(
      (1 + 2 * var(--projects-panel-plinth-overhang)) * var(--projects-panel-frame-share) /
        var(--projects-panel-stage-share) * 100%
    );
    margin-top: calc(-1 * var(--projects-panel-plinth-back));
    height: calc(var(--projects-panel-plinth-depth) + var(--projects-panel-plinth-back));
    background-image: var(--projects-panel-plinth-src);
    background-size: 100% 100%;
    background-repeat: no-repeat;
  }

  /* ---- the reflection ------------------------------------------------------
     THE FRAME AGAIN, UPSIDE DOWN AND LYING IN THE STONE. Not a picture of it:
     the copy inside this box is a live clone of the real Frame — the same
     chrome, the same titlebar, and a second recording playing in step with the
     first — so what the stone shows moves with what the window shows. A still
     reflection under a moving clip reads as broken immediately. reflection.ts makes
     the copy and says why it is made in script rather than written out twice.

     THIS BOX IS THE TOP FACE AND NOTHING ELSE. It starts at the contact line, it
     is exactly `face` deep, and it clips — so no part of the reflection can
     reach the front face, which is a vertical surface and reflects nothing. Its
     left and right edges are the FRAME's: the overhanging marble at each end has
     no window above it to reflect.

     A MIRROR IMAGE IS THE SAME SIZE AS THE THING IT REFLECTS, and getting that
     wrong is what made this read as a smear rather than as a reflection. A
     planar mirror puts the image as far behind the surface as the object is in
     front of it, so object and image subtend the same angle at the eye and
     project to the same height. The visible strip is short because the SLAB is
     short, not because the image is. The share was read as a SCALE and applied
     as one, and the whole window was squashed into the thirteen pixels that are
     actually the bottom 3.28% of it seen life-size — thirty rows of chrome, tabs
     and clip averaged into every row of stone, a grey band that changes when the
     clip changes. The transform is therefore a plain fold and the clipping is
     this box's own `overflow`.

     NO `filter: blur()`. Roughness 0.07 at 82 degrees of incidence spreads a
     reflection by something on the order of a pixel over a strip thirteen deep,
     which is not worth a full-size gaussian over a moving picture on every frame
     — the per-frame cost this Section is built without. What the eye reads as
     softness here is the contact shadow above and the stone's own veining
     showing through, and both are free.

     PLAIN ALPHA AND NOT `screen`, which is the physically-minded choice and the
     wrong one. A reflection adds light, so `screen` is what a reflection does —
     but the plate underneath already carries the light: its top face ramps from
     31 to 80 because that is what the render measures there, and that ramp IS
     the room reflected in the stone. Screening a second reflection over it puts
     the light in twice. Alpha also gets the dark half right for free: a black
     tab bar reflected in polished stone makes the stone DARKER than the marble
     beside it, which `screen` cannot do. */
  /* THE TOP FACE, STATED ONCE, because both boxes that lie on it ARE it — the
     reflection and the shadow are the same rectangle, and keeping two copies of
     it equal by hand is how one of them ends up on a face the other is not on.
     Its top edge is THE CONTACT LINE and not the slab's, which runs `back`
     further behind the Frame: the marble back there has a window standing on it
     rather than anything lying in it. Its ends are the Frame's, because the
     overhanging marble has no window above it to reflect or to be shadowed by. */
  .projects-panel__reflection,
  .projects-panel__plinth::after {
    position: absolute;
    top: var(--projects-panel-plinth-back);
    left: var(--projects-panel-plinth-inset);
    right: var(--projects-panel-plinth-inset);
    height: var(--projects-panel-plinth-face);
  }

  .projects-panel__reflection {
    overflow: hidden;
    /* A stacking context, so the copy's own `z-index: 1` — it is a Frame and
       carries the class's — stays inside this box instead of competing with the
       real Frame's. */
    isolation: isolate;
    opacity: var(--projects-panel-reflection-strength);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000,
      rgb(0 0 0 / var(--projects-panel-reflection-far))
    );
    mask-image: linear-gradient(
      to bottom,
      #000,
      rgb(0 0 0 / var(--projects-panel-reflection-far))
    );
    pointer-events: none;
  }

  /* The copy. `bottom: 100%` stands it directly ON the contact line — its own
     bottom edge against this box's top — and the transform folds it back down
     through that same line: a fold about the bottom origin sends a point h above
     the origin to h below it, which is the whole of what a mirror is, at the one
     magnification a mirror has.

     NOTHING CLIPS IT HERE. The flipped copy is the Frame's full height and hangs
     the whole way down through the slab and out of the composition; what cuts it
     to the marble available is `overflow: hidden` on the box above, which is the
     front arris of the slab and is exactly the thing that cuts it in life.

     `left` AND `right` AND NO WIDTH, so the copy is the reflection box's width, which is
     the Frame's. A width stated here would be the same number written twice. */
  .projects-panel__reflection > .projects-panel__frame {
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    transform: scaleY(-1);
    transform-origin: bottom;
  }

  /* ---- the contact shadow --------------------------------------------------
     WHERE THE WINDOW MEETS THE STONE, and its absence was the loudest thing in
     the composition. Everything else on this Plinth is a question of how the
     marble is lit or how the reflection is shaped; this is the cue the eye uses
     to decide whether two objects are TOUCHING at all, and there was none — the
     Frame ended, the marble began, and nothing happened at the join, which is
     what a sticker on a photograph looks like.

     IT SITS ON THE TOP FACE AND STOPS THERE. Not a soft shadow spilling down the
     front, which is the reflex and is wrong: the front face is a vertical plane
     over a Frame width away from the foot in the depth direction, and the light
     that fills it is in FRONT of the block, so the window occludes none of it.
     The height is therefore the top face exactly, and the two ends are the same
     pair the reflection uses.

     ABOVE THE REFLECTION, which is a decision rather than an accident of order.
     An occlusion strictly darkens the diffuse term and leaves the specular
     alone, so a purist would paint it under. But what is occluded here is also
     most of the room the stone had to reflect in the first place, and a
     reflection that stays at full strength right up to the foot of the thing
     casting it looks lit from underneath. */
  .projects-panel__plinth::after {
    content: '';
    /* Over the reflection, which carries no z-index of its own. Still under the
       Frame, which is a sibling of the whole Plinth at z-index 1, so the half of
       this that falls under the window is covered by it — as it should be. */
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--projects-panel-contact-near) 0%,
      var(--projects-panel-contact-mid) var(--projects-panel-contact-mid-at),
      var(--projects-panel-contact-far) var(--projects-panel-contact-far-at),
      rgb(0 0 0 / 0) 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--projects-panel-contact-ends),
      #000 calc(100% - var(--projects-panel-contact-ends)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--projects-panel-contact-ends),
      #000 calc(100% - var(--projects-panel-contact-ends)),
      transparent 100%
    );
  }

  /* ---- one column, outside the band the composition is fitted to ---------
     The drawing stops being self-similar below about 925px — the floored parts
     outgrow the space the shares left them — so it becomes a stack that is as
     tall as it needs to be. NOTES.md has the sweep. */
  @media not all and (min-width: 1100px) {
    .projects-panel {
      /* No height term and no fit to solve for: the stack takes the width it is
         given. The side margin is the page's horizontal one, not --inset, which
         is a vertical measure and reads as an error used across. */
      --projects-panel-w: calc(100vw - 2 * var(--projects-panel-side));
      /* The Frame is the whole column here rather than nine twelfths of it, so
         the Plinth's three depths — the only things that read this — are shares
         of the stack's own width.

         `100vw` INCLUDES A CLASSIC SCROLLBAR AND THIS BOX DOES NOT, which is the
         one length in this block that is not exact. The stacked page always
         scrolls, so on a platform that reserves a gutter the width above runs
         about 15px over the box it describes. Nothing lays out FROM it — the
         column is `1fr` and the Plinth's width below is a real percentage — so
         the drawing is the right shape either way. What drifts is the three
         depths, by 15 in 1055 at the top of this block's range. The fix is not a
         smaller number: it is the stage becoming an inline-size container so the
         slab can be stated in `cqw`, and it cannot be — layout containment makes
         the stage a stacking context, which is the one thing the Frame's
         occlusion of the subheading cannot survive. */
      --projects-panel-frame-w: var(--projects-panel-w);
      --projects-panel-masthead-size: var(--projects-panel-masthead-stacked);
      --projects-panel-sub-size: var(--projects-panel-sub-stacked);
      --projects-panel-copy-size: var(--projects-panel-copy-stacked);
      --projects-panel-small-size: var(--projects-panel-small-stacked);
      --projects-panel-rail-size: var(--projects-panel-rail-stacked);

      padding: var(--projects-panel-inset) var(--projects-panel-side);
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--projects-panel-stack-gap);
    }

    /* Three names across the top instead of three down an edge, and they wrap:
       360 and 320 are real screens and RECORD ENGINE does not fit beside the
       other two on either. */
    .projects-panel__rail-items {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-start;
      align-items: baseline;
      column-gap: var(--projects-panel-stack-rail-gap);
      row-gap: var(--projects-panel-stack-rail-rows);
    }

    .projects-panel__rail-item {
      writing-mode: horizontal-tb;
      transform: none;
    }

    .projects-panel__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      align-self: stretch;
      row-gap: var(--projects-panel-stack-gap);
    }

    .projects-panel__head,
    .projects-panel__copy,
    .projects-panel__points,
    .projects-panel__stage {
      grid-column: 1;
      align-self: auto;
    }

    /* The hanging second line goes back into its own box, and the occlusion the
       Frame is going to make of it goes with it. */
    .projects-panel__head {
      grid-row: 1;
      margin-bottom: 0;
    }

    /* The rule moves from the paragraph's left edge to its top, which is where a
       divider goes when the thing it divides is above rather than beside. */
    .projects-panel__copy {
      grid-row: 2;
      border-left: 0;
      border-top: 1px solid var(--projects-panel-rule);
      padding: var(--projects-panel-stack-gap) 0 0;
      max-width: var(--projects-panel-stack-measure);
    }

    /* The Frame under the copy and the points last, stated as rows so the
       markup keeps the order it was written for. The occlusion is dropped rather
       than approximated: at this width the window would cover the line rather
       than bite a quarter off the letters. */
    .projects-panel__stage {
      grid-row: 3;
      margin-top: 0;
    }

    /* The Frame is the whole column, so both of the numbers that placed it
       inside the stage go — and the Plinth's two, which were shares of a stage
       ten columns wide, become shares of a stage that is the Frame.

       BOTH ARE ONE NUMBER EACH AND BOTH ARE THE RENDER'S. Restating only the
       Frame's margin and leaving the slab's alone is the failure worth naming:
       it overhangs by 9.47% on the left while ending 1.6% SHORT of the Frame's
       right foot, which is a window standing off the end of its own plinth — and
       the reflection inherits the error exactly, since it is placed off the
       slab. */
    .projects-panel__stage > .projects-panel__frame {
      margin-left: 0;
    }

    .projects-panel__plinth {
      margin-left: calc(-1 * var(--projects-panel-plinth-overhang) * 100%);
      width: calc((1 + 2 * var(--projects-panel-plinth-overhang)) * 100%);
    }

    /* A multiple of the points' own size, and it has to beat the 0.35em inside
       each point or the list reads as eight lines rather than four pairs. */
    .projects-panel__points {
      grid-row: 4;
      margin-top: 0;
      row-gap: calc(var(--projects-panel-stack-points-gap) * var(--projects-panel-small-size));
    }
  }

  /* ---- the landing ------------------------------------------------------
     THE WORD DOES NOT COME DOWN TO THIS SECTION; THIS SECTION COMES UP TO THE
     WORD. Inside the landing band the Front Screen's Cut Title stands in this
     masthead's slot, the masthead itself goes invisible underneath it, and the
     page turn between the two screens is what carries the reader here.
     src/kernel/landing.css is the whole of the device and the measure both
     Sections read; this block is the half of it that is the composition's.

     LAST IN THE SHEET, not up in the base block it argues with. A media query
     buys no specificity, and every rule here overrides one of the same weight —
     moved earlier they all silently lose and the Section comes out looking as
     though the landing had never been written. Same gate as the Front Screen's
     own block, deliberately: the three are one idea and have to stay in step. */
  @media (min-width: 1100px) and (min-height: 700px) {
    .projects-panel {
      /* The composition's width, RE-SOLVED for the landing and taken from the
         Kernel rather than restated: the Rail leaves the grid below, so the width
         branch is the whole of what the page has across, and the height branch
         has to answer for the Section beginning above the fold. The masthead, the
         cap the word is cut to and the drop the landing is measured by all follow
         from it through the shares in tokens.css, so nothing else in the Section
         has to know the landing exists. */
      --projects-panel-w: var(--landing-w);

      /* The port the turn comes to rest on, which is the word's landing and not
         this Section's own edge: the cap top lands on the same line the Front
         Screen's name starts on, one screen up. The base rule says the same thing
         one term shorter, for a Section whose top edge IS the fold. */
      scroll-margin-top: calc(var(--landing-top) - var(--projects-panel-mast-top));

      /* Exactly what the Section takes and no more, so the document is two
         screens: the Front Screen's height plus this is the fold plus the
         landing. That is what makes the crossing finish exactly as the scroll
         does. The padding it used to spend at the top is spent by the landing. */
      min-height: calc(var(--fold) - var(--landing-top) + var(--landing-mast-top));
      padding-top: 0;
      /* AND NONE AT THE FOOT OR ON THE RIGHT EITHER: THE PAGE'S MARGIN IS ON THE
         LEFT AND NOWHERE ELSE HERE. The top's is spent by the landing, and the
         other two are the Plinth's — the stone stands on the page's bottom edge
         and ends on its right one, and a margin is exactly the thing that cannot
         be between them.

         The foot also keeps the Section exactly `min-height` tall: the fall below
         spends every pixel of the box on the composition, so a bottom padding
         would be content plus padding OVER the minimum and the document would
         come out one page margin taller than two screens — the crossing finishing
         before the scroll does.

         AND THE RIGHT ONE IS WHAT LETS THE COMPOSITION BE AS WIDE AS IT SOLVED
         FOR. The width branch spends the page across on the drawing and the stone
         together, so the column it asks for is wider than `100vw - 2 x inset`
         whenever the margin is large against the window — every window over about
         1156px tall, where the margin hits its 6.5rem cap. A right padding caps
         the column there without saying so, and then --projects-panel-w
         OVER-STATES the box that was actually laid out: the composition comes out
         narrow, the fall subtracts a Frame height that is not the Frame's, and the
         marble stops short of BOTH edges at once. 41px across and 15px down at
         1100x1440, which is the window that found it. Nothing is centred here and
         nothing lays out from the right edge, so there is nothing for the padding
         to do but that. */
      padding-bottom: 0;
      padding-right: 0;

      /* ---- THE FALL: what the drawing comes down by ------------------------
         THE PLINTH SITS SQUARE IN THE PAGE'S BOTTOM-RIGHT CORNER. The right half
         of that is the Kernel's — src/kernel/landing.css spends the page across
         on the composition AND the stone's overhang, so the marble's right end IS
         the page's right edge. This is the bottom half: the distance from where
         the composition's foot falls to where the page's foot is, and everything
         in row two comes down by it.

         WHY THERE IS ANYTHING TO COME DOWN BY. The drawing is self-similar, so it
         has one height for its width, and the width is the smaller of what the
         page has across and what its height will carry. Where the WIDTH binds the
         drawing is shorter than the screen, and the difference used to be black
         sitting under the marble. It is spent inside the composition instead.

         MEASURED, NOT RESTATED. Every term is a length the Section already has:
         the Section's own box, less the two rows the composition is built out of.
         The fit constant's own ratio is deliberately NOT one of them — writing
         0.5586 here would be a fourth copy of a number three files already
         disagree about by a third of a per cent, and the fall is exactly the size
         of that disagreement plus a page margin. So the sum below is the same
         arithmetic the browser lays the box out with, and the two agree to the
         pixel by construction rather than by luck.

         POSITIVE AT EVERY WINDOW IN THE BAND, on both branches: where the height
         binds it is the page margin the fit left over, and where the width binds
         it is that plus whatever the page's width could not spend. */
      --projects-panel-fall: calc(
        var(--fold) - var(--landing-top) + var(--landing-mast-top) -
          var(--projects-panel-mast-line) - var(--projects-panel-sub-line) -
          var(--projects-panel-frame-drop) - var(--projects-panel-plinth-depth) -
          var(--projects-panel-frame-w) / var(--projects-panel-frame-ratio)
      );

      /* ONE COLUMN. The Rail is out of flow below, so the composition's own left
         edge is the Section's content edge — the page's margin, which is exactly
         where the word stands. `start` and not `center`: the drawing hangs off the
         word, and on a window where the width binds rather than the height the
         leftover has to go under the composition rather than half of it above,
         which would push the subheading off the word's line. */
      grid-template-columns: minmax(0, var(--projects-panel-w));
      justify-content: start;
      align-items: start;

      /* NO GROUND OF ITS OWN, because the document has one and it is the
         Kernel's. Two things need this rather than tolerate it. The Section's box
         begins above the fold, so an opaque ground here would paint over the last
         strip of the three corner pictures, which stand behind the page and end
         at the fold. And one ground painted once cannot disagree with itself
         part-way through a crossing, which two elements holding two mixes of two
         different far ends demonstrably can: --projects-panel-bg-far was pure
         black while the Kernel's --dark was not, so mid-Turn the two came out a
         shade apart and the seam ran straight across the word. The Kernel's
         arrival is pure black now and the two far ends agree — but they agree at
         ONE end, and the near ends are still two different papers, so painting
         here would put the seam back everywhere except the bottom port.

         The Token stays what it was and is still what the Frame's glass is
         rendered against — what comes off is only this Section painting it. */
      background: none;
    }

    /* THE COMPOSITION STANDS AT THE SECTION'S OWN TOP EDGE, and that is what puts
       the masthead's line box under the word: the landing measures the drop from
       the Section's edge, so a composition centred in whatever height is left
       over sits ten pixels lower than the arithmetic says and the word no longer
       stands in its slot. The leftover goes under the drawing instead, which is
       the same answer the one-column grid above gives for the width. */
    .projects-panel__inner {
      align-self: start;
    }

    /* ---- row two comes down by the fall, and the line that hangs into it ---
       THREE BOXES AND ONE LENGTH. The stage is the one that has to move — the
       Plinth's foot is the composition's foot, so the fall is what puts it on the
       page's bottom edge — and the other two move because of what moving it
       costs.

       THE SUBHEADING'S SECOND LINE COMES WITH THE WINDOW. The Frame's top edge is
       a measured fraction into that line and the bite is the composition's, so a
       stage that fell on its own would leave the window a hundred pixels clear of
       the line it is supposed to occlude. The line falls the same distance and the
       drop between them is untouched — which is also why the `occlusion` Check
       still passes rather than having been retired.

       THE MASTHEAD DOES NOT MOVE, and the negative margin is what buys that. The
       head is `align-self: end` against a row of stated height, so its MARGIN box
       is what the row places: growing the content by the fall and the margin by
       the same amount leaves the margin box where it was, and the masthead — the
       slot the Cut Title stands in, which nothing may move — with it.

       AND THE POINTS COME DOWN BECAUSE THE LINE DID. Their top margin clears the
       hanging line by construction; leave it and the second line lands on top of
       the list, which is the collision this term exists to not have. */
    .projects-panel__head {
      margin-bottom: calc(-1 * (var(--projects-panel-sub-line) + var(--projects-panel-fall)));
    }

    .projects-panel__sub span:last-child {
      margin-top: var(--projects-panel-fall);
    }

    .projects-panel__points {
      margin-top: calc(
        var(--projects-panel-sub-line) + var(--projects-panel-fall) +
          var(--projects-panel-points-air)
      );
    }

    .projects-panel__stage {
      margin-top: calc(var(--projects-panel-frame-drop) + var(--projects-panel-fall));
    }

    /* WHY THE MASTHEAD STAYS IN THE MARKUP AND ONLY GOES INVISIBLE. Its box is
       load-bearing three times over: it is row one's stated height, it is what
       the subheading's second line hangs off — which is what makes the Frame's
       bite exact — and it is the slot the word now occupies. Take the box out and
       row one collapses onto the subheading, the paragraph beside it becomes what
       sizes the row, and the subheading sinks away from the word it is supposed
       to be the next line of. `visibility: hidden` keeps every one of those and
       draws nothing. It also keeps the accessible name, which this Section's
       `aria-labelledby` points at — a directly-referenced hidden element still
       supplies one — where `display: none` would not.
       Unconditional, and not gated on a script having run: there is no state to
       be in, so a browser that runs nothing gets this. */
    .projects-panel__masthead {
      visibility: hidden;
    }

    /* THE PARAGRAPH ARRIVES WITH THE PAGE, AND NOTHING ABOUT IT MOVES TO DO IT.

       WHAT IT FIXES. This Section begins above the fold, so its first row stands
       on the screen ABOVE — which is the whole point, because that strip is where
       the word is cut. Everything else in that row is accounted for: the masthead
       is invisible by the rule above and the subheading hangs below it. This
       paragraph was what was left, and it showed as two lines of small type in the
       white to the right of the word, answering a question the reader had not been
       asked yet.

       DRAWN AGAINST THE TURN, which is what makes it a function and not an
       animation. --turn is the Kernel's number for this exact crossing and already
       what every colour on the page is mixed out of, so the arrival inherits the
       page turn's quintic ease for nothing, is exact at both resting places and at
       a deep link, and reaches a reader who asked for less motion as a state
       rather than as a movement, because their turn is a jump. It is also still
       seekable through the seam ADR 0003 asks for: `timelines.get('turn').seek(…)`
       moves it, which is what the `turn` Check reads and what the Editor scrubs.
       THIS DOES NOT GIVE THE PANEL A TIMELINE — how the rest of the composition
       arrives is a later ticket, and timeline.ts says so.

       IT IS THE INK THAT ARRIVES, AND NOT THE BOX. `mask-image` was the first
       version of this and the wipe was the nicer picture — one front travelling
       down the block in reading order, carrying the hairline with it — and it was
       dropped on a measurement: a mask keeps the paragraph on its own compositing
       layer FOREVER, and composited text is text rasterised without subpixel
       antialiasing, up to 136 levels on a channel against the same type painted
       directly. This page is meant to be UNCHANGED once it has arrived. `opacity`
       is the one honest alternative — it costs the resting page nothing as long as
       it lands back on exactly 1, which is a condition that is easy to lose and
       silent when it goes, and the `turn` Check permits it and asserts the
       condition. A transform is neither: it is the one thing this device may not
       do, because this Section is the far end of a page turn whose whole claim is
       that the type stands still and the document moves. Mixing the ink towards
       `transparent` instead composites nothing at any moment — at the landing the
       two mixes below are the palette's own two colours, and not one pixel of the
       resting page is this rule's.

       THE HAIRLINE LEADS THE WORDS by the share its Token names, because that is
       what a printed page does: the margin is ruled and then it is written in.
       The rule is the border the base sheet already put there, so the lead is one
       more mix rather than anything new on the page. */
    .projects-panel__copy {
      --projects-panel-copy-arrive: clamp(
        0,
        calc(
          (var(--turn) - var(--projects-panel-copy-arrive-from)) /
            (var(--projects-panel-copy-arrive-to) - var(--projects-panel-copy-arrive-from))
        ),
        1
      );
      --projects-panel-copy-ruled: clamp(
        0,
        calc(var(--projects-panel-copy-arrive) / var(--projects-panel-copy-rule-lead)),
        1
      );

      color: color-mix(
        in oklab,
        var(--projects-panel-ink-soft),
        transparent calc((1 - var(--projects-panel-copy-arrive)) * 100%)
      );
      /* The colour alone, so the sheet's own `border-left: 1px solid` — its width
         and its style, which are the composition's — is not restated here. */
      border-left-color: color-mix(
        in oklab,
        var(--projects-panel-rule),
        transparent calc((1 - var(--projects-panel-copy-ruled)) * 100%)
      );
    }

    /* A BROWSER THAT RUNS NOTHING GETS THE PARAGRAPH, because nothing would ever
       drive --turn for it and the arrival would be a paragraph deleted rather than
       a paragraph waiting. It is the one state on the page that is better off with
       the leak, and it is the same reader the Plinth's full depth is drawn for —
       `projects-panel` asserts both in its scripting-off pass. THE QUERY AND NOT A
       SCRIPT-SET FLAG: a flag is set by a deferred module, a frame or two after
       first paint, so every reader would watch the paragraph appear and then be
       taken away. This is decided before the first paint instead. */
    @media (scripting: none) {
      .projects-panel__copy {
        --projects-panel-copy-arrive: 1;
        --projects-panel-copy-ruled: 1;
      }
    }

    /* THE RAIL MOVES OUT INTO THE PAGE'S MARGIN, which is what "the composition
       starts where the word starts" costs. In the grid it holds the first column
       and everything after it — the masthead included — is pushed right by its
       width and a gutter, so the word and this Section's own title could not be
       set to the same line. Out of flow and standing in the margin instead: it is
       one line of vertical type, the margin is exactly the white the page already
       leaves there, and an index in the margin is a thing a printed page does.
       The insets are against the Section's padding box, which is its whole box —
       absolute insets ignore padding — so `left: 0` is the window's edge and the
       width IS the margin, with the items' own centring putting the type down the
       middle of it. */
    .projects-panel__rail {
      position: absolute;
      left: 0;
      top: 0;
      bottom: var(--projects-panel-inset);
      width: var(--projects-panel-inset);
    }
  }
</style>

<script>
  import { mountClip } from './clip';
  import { mountGlass } from './glass';
  import { mountReflection } from './reflection';

  /* THE ORDER IS THE DESIGN AND NOT THE ALPHABET. The reflection is made first,
     so the two that follow each treat the copy as one more Frame on the page
     instead of as a special case: `mountClip` hands sources to every recording
     it finds, and `mountGlass` blits the material it rendered onto every
     titlebar. Reverse it and both would have to go looking for a reflection they
     know nothing about. reflection.ts says the same thing from the other end. */
  mountReflection();
  mountClip();
  mountGlass();
</script>
