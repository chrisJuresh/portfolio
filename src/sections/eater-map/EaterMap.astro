---
// The Eater Map Section: the Rail, a plain masthead and its two authored lines,
// the copy, the four numbered points, and the Exploded View — the captured Slab
// tilted under one camera with the app's own three surfaces raised off it.
// NOTES.md carries the reasoning: why the masthead is a plain word rather than a
// Cut Title, which of the Kernel's lengths this Section reads and why that is
// not joining the landing measure, and the two pieces of arithmetic the stage
// turns on.
//
// THE MARKUP RESTS IN THE RAISED STATE, and that inverts the obvious build
// (#177). The Lift animates FROM flat TOWARDS raised, so the finished Exploded
// View is what a reader whose scripts never arrived and a reader who asked for
// reduced motion each get for nothing, and nothing here is contingent on a
// script. Flat is `--eater-map-lift: 0` and it is where the motion begins.
import { CARDS } from './cards';
import { content } from './content';
import { SLAB } from './slab';
// The Eater app's own stylesheet, vendored with the Cards (#174). A plain CSS
// file, so Astro does not scope it — every selector in it begins with the
// `.eater-cards` host, and that host is the containment. NOTES.md.
import './assets/cards/cards.css';
import './tokens.css';
// variants.css is deliberately NOT imported: an unselected Variant has to cost
// the shipped page nothing, so the sheet is not part of the build at all and the
// render tool injects it. NOTES.md, and check-source.mjs if this is ever undone.
---

{/* data-section is the loader's handle: it names the Section whose timeline.ts
    is fetched as this element approaches the viewport, and it is what makes this
    a resting place — src/kernel/landing.css declares every Section after the
    first a port, as a relationship rather than a list, so nothing in the Kernel
    had to learn this Section's name.

    No data-turn. The crossing spans the FIRST Section and is finished by the
    time the Projects Panel comes to rest, so the page is already dark when the
    reader arrives here and there is no second crossing to run. src/kernel/turn.ts. */}
<section
  class="eater-map"
  id="eater-map"
  data-section="eater-map"
  aria-labelledby="eater-map-masthead"
>
  <nav class="eater-map__rail" aria-label={content.rail.label}>
    {/* role="list" on a list that already is one: `list-style: none` costs a
        list its semantics in VoiceOver, and the Rail is meant to be announced
        as a list of projects. */}
    <ul class="eater-map__rail-items" role="list">
      {content.rail.projects.map((project) => (
        <li
          class:list={[
            'eater-map__rail-item',
            { 'is-selected': project.href === '#eater-map' },
          ]}
        >
          {project.href ? (
            <a href={project.href} aria-current={project.href === '#eater-map' ? 'true' : undefined}>
              {project.name}
            </a>
          ) : (
            <Fragment>
              {project.name}
              <span class="eater-map__quiet">{content.rail.unbuilt}</span>
            </Fragment>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <div class="eater-map__inner">
    <header class="eater-map__head">
      <h2 class="eater-map__masthead" id="eater-map-masthead">{content.masthead}</h2>
      <p class="eater-map__sub">
        {content.subheading.map((line) => (
          <span>{line}</span>
        ))}
      </p>
    </header>
    <div class="eater-map__copy">
      {content.copy.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    {/* An <ol> because each point is numbered on the page and each will name one
        part of the Exploded View — #178 is the leader lines. */}
    <ol class="eater-map__points">
      {content.points.map((point) => (
        <li>
          <h3>{point.title}</h3>
          <p>{point.figure}</p>
        </li>
      ))}
    </ol>
    {/* THE EXPLODED VIEW: one still of the map, and the app's own three surfaces
        drawn on it at the scale the map is drawn at, so that flat it is
        indistinguishable from a screenshot of the phone — and is made of a
        picture and real text rather than of pixels. Raised, the same picture and
        the same three surfaces come apart under one camera.

        The two numbers below are the ONLY thing the markup says about geometry,
        they are not chosen, and they are not repeated anywhere: they are the
        capture's own, out of slab.ts, and every other length on this plane is
        derived from them or is a Token. A re-capture at another phone size moves
        them and the composition follows. NOTES.md.

        FOUR BOXES AND EACH HAS ONE JOB, which is one more than the flat state
        needed and is forced rather than chosen — NOTES.md has the two rules that
        force it. The Slab is the SIZE and the container the plane's lengths are
        shares of; the plane is the CAMERA and the one rotation everything on it
        shares; the Cards' box is the app's own stylesheet host; and each Card is
        a depth off the plane's surface. */}
    <div class="eater-map__stage">
      <div
        class="eater-map__slab"
        style={`--eater-map-app-w: ${SLAB.viewport.width}px; --eater-map-slab-ratio: ${SLAB.pixels.width} / ${SLAB.pixels.height}`}
      >
        <div class="eater-map__plane" data-eater-map-plane>
          {/* `lazy`, so the Slab's quarter of a megabyte arrives as the reader
              comes down the page rather than at load — the same promise the
              Section's own chunk makes, kept declaratively so it holds with no
              script at all. `alt` is Content: the picture carries a claim about
              the project and a reader who cannot see it is owed the claim. */}
          <img
            class="eater-map__still"
            src={SLAB.src}
            width={SLAB.pixels.width}
            height={SLAB.pixels.height}
            alt={content.stage.slabAlt}
            loading="lazy"
            decoding="async"
          />
          {/* `.eater-cards` is the vendored stylesheet's host and therefore its
              containment: every rule in that file begins with this class, so it
              reaches nothing above this element and nothing above it reaches in. */}
          <div class="eater-map__cards eater-cards">
            {CARDS.map((card) => (
              <div class="eater-map__card" data-eater-map-card={card.name} set:html={card.html} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scoped by the build. Astro rewrites every selector below with this
     component's own attribute, so none of them can match an element in another
     Section even by accident.

     THE SECTION PAINTS NO GROUND, and that is the rule rather than an omission.
     The page's ground is `html { background: var(--ground) }` in the Kernel and
     --ground is itself a crossing on --turn, so a Section that paints its own
     composes two crossings and puts a step across the page at its own top edge —
     which is what "banding" has meant both times it was reported. This Section
     inherits the page's ground and its ink in both themes, at the far end of a
     Turn that finished before the reader got here. */
  .eater-map {
    /* THE LIFT'S PLAYHEAD, AND IT IS NOT A TOKEN. 0 is the flat screenshot and 1
       is the finished Exploded View; the tilt, the depths and the gaps below are
       all it times a Token. It is declared HERE rather than in tokens.css
       because it is not a number the author chooses — `timeline.ts` writes it,
       the Editor's Timeline scrub is the control for it, and a second control in
       the Tokens panel would be two handles on one thing.

       IT RESTS AT 1, which is the whole of the inversion #177 asks for: the
       markup reads as the finished composition, the Timeline animates AWAY from
       it, and a reader whose scripts never arrived keeps the Exploded View
       rather than a half-built one. */
    --eater-map-lift: 1;
    box-sizing: border-box;
    display: grid;
    /* The Rail's column IS the page's left margin, the way it is in the Projects
       Panel: the names are set across it, so the margin has a floor under it and
       that floor is one rotated line of --eater-map-rail-size at its leading. */
    grid-template-columns: var(--eater-map-side) minmax(0, 1fr);
    column-gap: var(--eater-map-gap);
    /* STRETCH AND NOT CENTRE, and it is the difference between a composition
       that fits the screen and one that is taller than it. The Rail is spread
       `space-between` down its whole column and the stage is row two's
       remainder, so both need the Section's own height handed to them — centring
       would size the box to its content instead, and the content would then be
       whatever the four points and a picture-shaped box happen to add up to. */
    align-items: stretch;
    min-height: var(--fold);
    padding-block: var(--eater-map-inset);
    padding-inline-end: var(--eater-map-side);
    /* Clip, not hidden, and only across: `hidden` would make the Section a
       scroll container and break the Rail. */
    overflow-x: clip;
    font-family: var(--face-panel);
    font-weight: 400;
    line-height: var(--eater-map-leading);
  }

  /* ---- the Rail ---------------------------------------------------------- */
  .eater-map__rail {
    display: flex;
    align-self: stretch;
  }

  .eater-map__rail-items {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  .eater-map__rail-item {
    /* Turned per ITEM and not on the list: rotating the list would rotate the
       order with it and put the last project at the top. */
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-size: var(--eater-map-rail-size);
    letter-spacing: var(--eater-map-rail-tracking);
    color: color-mix(in oklab, var(--ink), transparent var(--eater-map-muted-veil));
  }

  .eater-map__rail-item.is-selected {
    color: var(--ink);
  }

  .eater-map__rail-item a {
    color: inherit;
    /* Three words in a margin: an underline across a rotated one reads as a
       strikethrough. */
    text-decoration: none;
  }

  .eater-map__rail-item:not(.is-selected) a:hover {
    color: var(--ink);
  }

  .eater-map__rail-item a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 3px;
  }

  .eater-map__quiet {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }

  /* ---- the composition: twelve columns, two rows ------------------------- */
  .eater-map__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    /* THE HEAD IS ITS OWN SIZE AND THE PICTURE IS EVERYTHING LEFT. `minmax(0,
       1fr)` and not `1fr`: a bare `1fr` floors at the row's min-content, so the
       four points and the box would push the Section past the fold rather than
       being given what the screen has. NOTES.md. */
    grid-template-rows: auto minmax(0, 1fr);
    column-gap: var(--eater-map-gutter);
    /* The one seam this box owns is the break between the writing and the
       picture, which is the biggest step on the ladder. */
    row-gap: var(--eater-map-act);
  }

  .eater-map__head {
    grid-area: 1 / 1 / 2 / 7;
    align-self: end;
  }

  /* ---- how the capitalised things are set --------------------------------
     Listed rather than hoisted onto the Section: `case` on the copy would raise
     the hyphen in "offline-first" off its own baseline, and the figures are
     sentences rather than labels. */
  .eater-map__masthead,
  .eater-map__sub,
  .eater-map__rail-item,
  .eater-map__points h3 {
    text-transform: uppercase;
    font-feature-settings: 'case' 1;
  }

  /* A PLAIN MASTHEAD, AND IT PAINTS. The Projects Panel's is hidden because the
     Front Screen's Cut Title is already that Section's head; nothing is cut into
     this one's slot, because #172 measured what a second landing solve would
     cost and the answer was the Panel's whole marble corner. NOTES.md. */
  .eater-map__masthead {
    margin: 0;
    font-size: var(--eater-map-masthead-size);
    font-weight: var(--eater-map-masthead-weight);
    line-height: var(--eater-map-masthead-leading);
    letter-spacing: var(--eater-map-masthead-tracking);
    color: var(--ink);
  }

  .eater-map__sub {
    margin: var(--eater-map-close) 0 0;
    font-size: var(--eater-map-sub-size);
    font-weight: 400;
    line-height: var(--eater-map-sub-leading);
    color: color-mix(in oklab, var(--ink), transparent var(--eater-map-muted-veil));
  }

  /* `block` on the spans rather than a <br>, so the break is a property of the
     composition and not a character a screen reader has to read around. */
  .eater-map__sub span {
    display: block;
  }

  .eater-map__copy {
    grid-area: 1 / 7 / 2 / 13;
    align-self: end;
    border-left: 1px solid
      color-mix(in oklab, var(--ink), transparent var(--eater-map-rule-veil));
    padding-left: var(--eater-map-copy-inset);
    font-size: var(--eater-map-copy-size);
    line-height: var(--eater-map-copy-leading);
    color: var(--ink-soft);
  }

  .eater-map__copy p {
    margin: 0;
  }

  .eater-map__copy p + p {
    margin-top: 1em;
  }

  /* The four points take the whole of their column and spread themselves down
     it, the way the Panel's do: the air is what a point growing a paragraph
     spends, down to the step and no further. */
  .eater-map__points {
    grid-area: 2 / 1 / 3 / 4;
    align-self: stretch;
    margin: 0;
    list-style: none;
    padding: 0;
    display: grid;
    grid-auto-rows: min-content;
    align-content: space-between;
    row-gap: var(--eater-map-step);
  }

  .eater-map__points h3 {
    margin: 0;
    font-size: var(--eater-map-point-size);
    font-weight: var(--eater-map-point-weight);
    line-height: var(--eater-map-point-leading);
    letter-spacing: var(--eater-map-point-tracking);
    color: var(--ink);
    /* A title set to fit its column on one line at the window it was drawn at
       wraps on a narrower one rather than being made to fit by a size nobody
       chose; `balance` makes the two lines halves of a title. */
    text-wrap: balance;
  }

  .eater-map__points p {
    margin: var(--eater-map-figure-air) 0 0;
    font-size: var(--eater-map-figure-size);
    line-height: var(--eater-map-figure-leading);
    color: color-mix(in oklab, var(--ink), transparent var(--eater-map-muted-veil));
  }

  /* ---- the Exploded View --------------------------------------------------
     A picture of the map, and the app's own three surfaces on it. What makes it
     read as one screenshot rather than as three stickers on a photograph is that
     the whole plane is drawn in ONE coordinate system — the phone's — and
     everything on it is a share of that. What keeps that true once it comes
     apart is that there is ONE camera and ONE rotation, both on the plane, and
     every part of the drawing is inside it. NOTES.md. */
  .eater-map__stage {
    grid-area: 2 / 4 / 3 / 13;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* THE PLANE. Its height is what row two has left, times the one Token that
     says how much of that to take, and its width follows from the capture's own
     proportion — so the phone is as big as the screen allows at every window in
     the band and the composition never has to be told a size.

     `container-type: inline-size` is what lets everything on the plane be a
     share of the plane. It is the Frame's arrangement in the Projects Panel and
     it carries the Frame's trap with it: AN ELEMENT IS NOT ITS OWN CONTAINER, so
     a `cqw` written on this rule would silently resolve against the viewport.
     Every one of them below is on a descendant.

     NOT CLIPPED, AND IT USED TO BE. While the Cards lay flat on the picture a
     Card hanging off its edge was a Card not lying on it, and `overflow: hidden`
     said so. Raised, a Card standing off the surface is exactly what the drawing
     is of — and the clip could not have stayed in any case: `overflow` other
     than `visible` makes an element a GROUPING element, and a grouping element's
     `transform-style: preserve-3d` is forced back to `flat`, so the clip alone
     would have flattened the Cards into the picture with no error and no
     warning. NOTES.md. */
  .eater-map__slab {
    position: relative;
    height: calc(var(--eater-map-slab-fill) * 100%);
    aspect-ratio: var(--eater-map-slab-ratio);
    /* A percentage translate resolves against the element's own box, so this is
       a share of the phone rather than of whatever the stage happens to be. */
    translate: calc(var(--eater-map-slab-shift) * 100%);
    container-type: inline-size;
  }

  /* THE ONE CAMERA, AND THE ONE ROTATION EVERY PART SHARES. The picture and all
     three Cards are inside this box, so there is exactly one projection on the
     page and no element carries a rotation of its own — which is what makes this
     one object taken apart rather than three stickers on a photograph.

     `perspective()` IS A TRANSFORM FUNCTION HERE AND NOT THE PROPERTY, and that
     is what saves a fifth box. The property projects an element's CHILDREN, so
     it would have to sit on the Slab — and the Slab is `container-type`, which
     is `contain: layout`, which is grouping, which would force this element's
     `preserve-3d` back to `flat`. As a function it projects this element's own
     rotation and its children's depths together, and it may be written in `cqw`
     because the plane is not itself the container. NOTES.md carries both rules.

     THE DOLLY IS PART OF THE CAMERA AND NOT A SIZE. The Cards climb towards the
     lens, so they grow — and a drawing whose pieces all grow outruns the box the
     screenshot fitted. The answer is the camera pulling back rather than the
     Slab being drawn smaller: the map recedes as its pieces come off it, the
     topmost Card stays about life size, and the FLAT frame keeps the size #176
     gave it. It is written BEFORE the two rotations, so it pushes the drawing
     away from the lens rather than along the tilted plane's own normal.

     Every term is the Lift's playhead times a Token, so progress 0 is
     `translateZ(0) rotate(0) rotate(0)` — the plane lies flat at the size it was
     drawn at, and the composition is the screenshot #176 built, to the pixel. */
  .eater-map__plane {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: perspective(calc(var(--eater-map-camera) * 100cqw))
      translateZ(calc(var(--eater-map-lift) * var(--eater-map-dolly) * -100cqw))
      rotateX(calc(var(--eater-map-lift) * var(--eater-map-tilt)))
      rotateZ(calc(var(--eater-map-lift) * var(--eater-map-swing)));
  }

  .eater-map__still {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* THE ONE PIECE OF ARITHMETIC THE STAGE TURNS ON: the scale everything on the
     plane is drawn at is the Slab's drawn width over the phone Eater was driven
     at. Get it from anywhere else — a number chosen by eye, a share of the
     viewport — and the Cards are the right size at one window and floating over
     a map of the wrong scale at every other.

     `tan(atan2(a, b))` is `a / b`. CSS has no other way to divide one length by
     another: `calc()` requires the right-hand side of a `/` to be a number, and
     that is the spec rather than an engine's gap. NOTES.md.

     `preserve-3d` here is not decoration either: without it this box flattens its
     children into itself and every Card's depth is discarded silently — the Cards
     would still be there, at the right scale, lying on the map for ever. */
  .eater-map__cards {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    --eater-map-app-scale: tan(atan2(100cqw, var(--eater-map-app-w)));
    /* The app's own three glass colours, taken off its host so the Cards can be
       given something to stand on once the Lift takes their backdrop away. Read
       here and spent one element down, because a custom property that refers to
       its own name is a cycle and computes to nothing. See below. */
    --eater-map-glass: var(--glass);
    --eater-map-glass-sheet: var(--glass-sheet);
    --eater-map-glass-float: var(--glass-sheet-float);
  }

  /* An engine without the trigonometric functions gets a plausible screenshot
     rather than an interface drawn at the app's own pixel size over a map a
     third that scale, which is what an invalid scale would leave. The number is
     the ratio at the window the Checks run at. */
  @supports not (scale: tan(atan2(1px, 1px))) {
    .eater-map__cards {
      --eater-map-app-scale: 0.72;
    }
  }

  /* Each Card at its own corner of the picture, in the picture's own units, and
     at its own depth off it. The Cards carry their own frozen pixel sizes — they
     are the app's markup at the window it was exported at (NOTES.md) — so the
     scale is a transform and never a width: a width would reflow another
     repository's interface.

     THE CARD'S OWN PLAYHEAD, defaulting to the Section's. `timeline.ts` writes
     this one per Card so the three can climb one after another; nothing writes
     it when no script arrives, and the `var()` then hands each Card the Section's
     own 1 and the stack is up. Both are the same number and neither is a Token.

     TRANSLATE FIRST AND SCALE SECOND, and the order is the arithmetic: a
     transform list applies right to left, so the scale is the Card's own and the
     translate is in the PLANE's units — a depth in the picture's own coordinate
     system rather than in the app's. Written the other way round the app's own
     scale would multiply the depth and each Card would rise by a different
     amount for the same Token. Both distances are `cqw`, so they are shares of
     the Slab as everything else on the plane is, and the drawing holds its shape
     at every window.

     GLASS CANNOT BE CARRIED OFF A SURFACE, and this is the one thing the Lift
     costs that no Token can put back. A `backdrop-filter` samples what is painted
     behind an element IN ITS OWN PLANE, and there is no such thing once the plane
     is turned under a camera: Chromium hands the filter an empty backdrop and it
     becomes a no-op, silently, at the FIRST DEGREE of tilt. Measured — with the
     depths and the gap set to 0 and only the tilt standing, the app's frosted
     detail panel is already a sheet of clear glass with a sharp map behind its
     text, which is a composition a reader cannot read. NOTES.md.

     So the composition gives each Card the plate its glass was standing in for,
     in step with the Card's own climb: on the Slab the app's own translucency is
     what a screenshot has, and off it the same surfaces are filled to
     --eater-map-plate. The three values are the APP'S OWN, mixed rather than
     restated — this Section never says what colour Eater's glass is, only which
     way it fills as it leaves the map. */
  .eater-map__card {
    --eater-map-card-lift: var(--eater-map-lift);
    --eater-map-card-rise: calc(
      var(--eater-map-card-lift) * var(--eater-map-rise) * var(--eater-map-card-depth)
    );
    /* Up the plane for the Cards near the top of the stack and down it for the
       ones near the bottom, so the pieces draw apart as they climb instead of
       stacking on one line of sight. Half the gap either way. */
    --eater-map-card-drift: calc(
      var(--eater-map-card-lift) * var(--eater-map-card-gap) * (0.5 - var(--eater-map-card-depth))
    );
    --eater-map-card-fill: calc(var(--eater-map-card-lift) * 100%);
    --glass: color-mix(in srgb, var(--eater-map-glass), var(--eater-map-plate) var(--eater-map-card-fill));
    --glass-sheet: color-mix(
      in srgb,
      var(--eater-map-glass-sheet),
      var(--eater-map-plate) var(--eater-map-card-fill)
    );
    --glass-sheet-float: color-mix(
      in srgb,
      var(--eater-map-glass-float),
      var(--eater-map-plate) var(--eater-map-card-fill)
    );
    position: absolute;
    left: calc(var(--eater-map-card-x) * 100%);
    top: calc(var(--eater-map-card-y) * 100%);
    transform-origin: 0 0;
    transform: translate3d(
        0,
        calc(var(--eater-map-card-drift) * 100cqw),
        calc(var(--eater-map-card-rise) * 100cqw)
      )
      scale(calc(var(--eater-map-app-scale) * var(--eater-map-card-scale)));
  }

  .eater-map__card[data-eater-map-card='search'] {
    --eater-map-card-x: var(--eater-map-card-search-x);
    --eater-map-card-y: var(--eater-map-card-search-y);
    --eater-map-card-depth: var(--eater-map-card-search-depth);
  }

  .eater-map__card[data-eater-map-card='lines'] {
    --eater-map-card-x: var(--eater-map-card-lines-x);
    --eater-map-card-y: var(--eater-map-card-lines-y);
    --eater-map-card-depth: var(--eater-map-card-lines-depth);
  }

  .eater-map__card[data-eater-map-card='details'] {
    --eater-map-card-x: var(--eater-map-card-details-x);
    --eater-map-card-y: var(--eater-map-card-details-y);
