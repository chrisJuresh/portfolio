---
// /portfolio — the Portfolio. One document, and the only one: the hand-written
// tree that used to answer here is gone, and this is what a reader arrives at.
//
// `/portfolio/<section>` is this same document, rewritten onto this path by the
// deployment (ADR 0001) and opened at the Section the last segment names. The
// rewrites are declared in vercel.json, the local servers mirror them out of
// that same file, and the Shell makes the jump.
import EaterMap from '../sections/eater-map/EaterMap.astro';
import FrontScreen from '../sections/front-screen/FrontScreen.astro';
import ProjectsPanel from '../sections/projects-panel/ProjectsPanel.astro';
import Shell from '../shell/Shell.astro';

/** The social card, which is a photograph off this page rather than a rendering
 *  of it — the same one the page it replaces named, so a link already shared
 *  keeps its picture. */
const CARD = 'https://chrisj.uk/portfolio/img/1100328.jpg';
const HERE = 'https://chrisj.uk/portfolio';
---

<Shell
  title="Christian Juresh"
  description="Software engineer in London."
>
  <Fragment slot="head">
    {/* CANONICAL FOR EVERY DEEP LINK, not only for this path. A rewrite serves
        this document at `/portfolio/<section>` as well, so without this the same
        page is indexed once per Section. */}
    <link rel="canonical" href={HERE} />
    <meta property="og:url" content={HERE} />
    <meta property="og:image" content={CARD} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={CARD} />
  </Fragment>
  {/* Nothing carries data-turn, and that is the right answer rather than an
      omission: the crossing starts at the top of the document and runs the
      length the Kernel states, which is the FIRST Section going past. Marking a
      Section instead would put `top top` and `bottom bottom` on the same scroll
      position and make the crossing a flip — see the Front Screen's NOTES.md,
      and the Check that asserts the span.

      THE ORDER IS THE PAGE TURN, and it is the only place the order is written.
      Every Section after the first is a resting place (src/kernel/landing.css
      says so as a relationship, not as a list), so a Section added here is a
      port the day it lands and the Kernel never learns its name. The crossing
      finishes at the second one, so the Panel and everything after it are dark —
      src/kernel/turn.ts. */}
  <FrontScreen />
  <ProjectsPanel />
  <EaterMap />
</Shell>
