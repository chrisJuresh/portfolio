    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.2.4",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "gsap": "3.15.0"
  }
}
